    "story"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#21252B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/StoryTW/vscode-story-dark.git"
  },
  "bugs": {
    "url": "https://github.com/StoryTW/vscode-story-dark/issues"
  },
  "homepage": "https://github.com/StoryTW/vscode-story-dark#readme",
  "scripts": {
    "package": "vsce package --no-dependencies"
  },
  "contributes": {
    "themes": [
      {
        "id": "Story Dark",
        "label": "Story Dark Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/Story-Dark-color-theme.json"
